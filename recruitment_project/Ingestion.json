  "name": "Ingestion",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const recruiterMap = {\n  'Ana Reyes': 'a1b2c3d4-e5f6-7890-abcd-ef1234567890',\n  'David Park': 'b2c3d4e5-f6a7-8901-bcde-f12345678901',\n  'Sarah Mwangi': 'c3d4e5f6-a7b8-9012-cdef-123456789012'\n};\n\nconst wpMap = {\n  'Acme Corp - Technology Transformation': 'd4e5f6a7-b8c9-0123-defa-234567890123',\n  'Acme Corp - Data & Analytics': 'e5f6a7b8-c9d0-1234-efab-345678901234',\n  'Pinnacle Health - Digital Operations': 'f6a7b8c9-d0e1-2345-fabc-456789012345'\n};\n\nconst validSources = ['hiring_manager', 'candidate', 'sourcing', 'market', 'internal_team', 'other', ''];\nconst validTypes = ['requirement_change', 'market_intel', 'candidate_feedback', 'process_note', 'sourcing_lead', 'risk_flag', 'general', ''];\nconst validUrgencies = ['action_needed', 'heads_up', 'for_context', ''];\nconst validVisibilities = ['internal_only', 'client_shareable', ''];\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const input = item.json;\n  const errors = [];\n\n  // Required: note\n  if (!input.note || input.note.trim() === '') {\n    errors.push('Note is required');\n  }\n\n  // Required: created_by\n  if (!input.created_by || input.created_by.trim() === '') {\n    errors.push('Recruiter (created_by) is required');\n  }\n\n  // Validate enums if provided\n  if (input.signal_source && !validSources.includes(input.signal_source)) {\n    errors.push(`Invalid signal_source: ${input.signal_source}`);\n  }\n  if (input.signal_type && !validTypes.includes(input.signal_type)) {\n    errors.push(`Invalid signal_type: ${input.signal_type}`);\n  }\n  if (input.urgency && !validUrgencies.includes(input.urgency)) {\n    errors.push(`Invalid urgency: ${input.urgency}`);\n  }\n  if (input.visibility && !validVisibilities.includes(input.visibility)) {\n    errors.push(`Invalid visibility: ${input.visibility}`);\n  }\n\n  // Resolve UUIDs\n  const createdByUUID = input.created_by ? (recruiterMap[input.created_by] || null) : null;\n  const wpUUID = input.wp_id ? (wpMap[input.wp_id] || null) : null;\n\n  if (input.created_by && !createdByUUID) {\n    errors.push(`Recruiter not found: ${input.created_by}`);\n  }\n  if (input.wp_id && !wpUUID) {\n    errors.push(`Work Packet not found: ${input.wp_id}`);\n  }\n\n  results.push({\n    json: {\n      row_number: input.row_number,\n      sheet_id: input.id,\n      isValid: errors.length === 0,\n      errors: errors,\n      payload: {\n        id: input.id,\n        wp_id: wpUUID || null,\n        position_code: input.position_code || null,\n        note: input.note,\n        signal_source: input.signal_source || null,\n        signal_type: input.signal_type || null,\n        urgency: input.urgency || 'for_context',\n        tags: input.tags \n          ? input.tags.split('|').map(t => t.trim()).filter(t => t) \n          : [],\n        visibility: input.visibility || 'internal_only',\n        created_by: createdByUUID,\n        created_at: input.created_at || new Date().toISOString()\n      }\n    }\n  });\n}\n\nreturn results;"
      },
