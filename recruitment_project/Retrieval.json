    {
      "parameters": {
        "jsCode": "const rows = [];\nconst actionItems = $('Get Action Needed').all().map(i => i.json);\nconst recentItems = $('Get Recent').all().map(i => i.json);\nconst actionIds = new Set(actionItems.map(d => d.id));\n\n// --- SECTION HEADER: Action Needed ---\nrows.push({\n  section: '--- ACTION NEEDED ---',\n  wp_name: '', position: '', note: '', signal_source: '',\n  signal_type: '', urgency: '', tags: '', visibility: '',\n  created_by: '', created_at: ''\n});\n\nfor (const d of actionItems) {\n  rows.push({\n    section: '',\n    wp_name: d.wp_name || '', position: d.position || '',\n    note: d.note || '', signal_source: d.signal_source || '',\n    signal_type: d.signal_type || '', urgency: d.urgency || '',\n    tags: d.tags || '', visibility: d.visibility || '',\n    created_by: d.created_by || '', created_at: d.created_at || ''\n  });\n}\n\n// --- Blank separator ---\nrows.push({\n  section: '', wp_name: '', position: '', note: '', signal_source: '',\n  signal_type: '', urgency: '', tags: '', visibility: '',\n  created_by: '', created_at: ''\n});\n\n// --- SECTION HEADER: Recent ---\nrows.push({\n  section: '--- RECENT ACTIVITY ---',\n  wp_name: '', position: '', note: '', signal_source: '',\n  signal_type: '', urgency: '', tags: '', visibility: '',\n  created_by: '', created_at: ''\n});\n\nfor (const d of recentItems) {\n  if (actionIds.has(d.id)) continue;\n  rows.push({\n    section: '',\n    wp_name: d.wp_name || '', position: d.position || '',\n    note: d.note || '', signal_source: d.signal_source || '',\n    signal_type: d.signal_type || '', urgency: d.urgency || '',\n    tags: d.tags || '', visibility: d.visibility || '',\n    created_by: d.created_by || '', created_at: d.created_at || ''\n  });\n}\n\nreturn rows.map(r => ({ json: r }));"
      },
